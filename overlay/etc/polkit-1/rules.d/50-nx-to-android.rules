// "Restart into Android" (nx-to-android) starts this unit; the logged-in desktop user may do that
// without a password, as they may reboot. Nothing else is allowed.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" && subject.local && subject.active &&
        action.lookup("unit") == "nx-to-android.service" && action.lookup("verb") == "start") {
        return polkit.Result.YES;
    }
});
