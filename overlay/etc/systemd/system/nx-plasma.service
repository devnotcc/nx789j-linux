[Unit]
Description=NX789J KDE Plasma desktop for user nx
# (not after NetworkManager or systemd-user-sessions, which waits for the network: Wi-Fi is
# started late on purpose and the desktop must not wait for it)
After=nx-tune.service systemd-logind.service dbus.service
Wants=dbus.socket

[Service]
User=nx
PAMName=login
# no virtual terminals on this kernel: the session sits on seat0 without a VT and KWin gets the
# display and input devices from logind
Environment=LANG=C.UTF-8 XDG_CURRENT_DESKTOP=KDE XDG_SESSION_DESKTOP=KDE XDG_SESSION_TYPE=wayland XDG_SESSION_CLASS=user XDG_SEAT=seat0
Environment=KWIN_DRM_DEVICES=/dev/dri/card0 KWIN_COMPOSE=O2ES
# full-screen repaints: with partial repaints (buffer age) this GPU driver shows stale regions
# during animations
Environment=KWIN_USE_BUFFER_AGE=0
# GPU: our Mesa build (Turnip on the kernel's Adreno driver, OpenGL ES through Zink)
Environment=LD_LIBRARY_PATH=/opt/nx-mesa/lib MESA_LOADER_DRIVER_OVERRIDE=zink VK_ICD_FILENAMES=/opt/nx-mesa/share/vulkan/icd.d/freedreno_icd.aarch64.json
Environment=MOZ_ENABLE_WAYLAND=1
ExecStart=/usr/lib/aarch64-linux-gnu/libexec/plasma-dbus-run-session-if-needed /usr/bin/startplasma-wayland
ExecStartPost=+/usr/local/sbin/nx-screen set 600
# the nx account has no password to unlock with: release the lock screen if the shell starts
# locked (remove this line after setting a password with "passwd nx")
ExecStartPost=+/bin/sh -c "sleep 12; loginctl unlock-sessions; /usr/local/bin/nx-display outputs"
# KWin and the shell live in the user's service manager and would outlive this unit
ExecStopPost=+/bin/systemctl restart user@1000.service
Restart=always
RestartSec=3
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target
