#!/bin/sh
# /etc/resolv.conf = NetworkManager's resolver list (Wi-Fi) followed by the mobile data
# carrier's DNS servers (nx-mobiledata). Run by nx-resolv.path whenever NetworkManager rewrites
# its file, and by nx-mobiledata. NetworkManager itself leaves /etc/resolv.conf alone
# (rc-manager=unmanaged in /etc/NetworkManager/conf.d/10-nx789j.conf).
NM=/run/NetworkManager/resolv.conf
MOB=/run/nx/mobile-dns
OUT=/run/nx/resolv.conf
mkdir -p /run/nx
{
	echo "# generated by nx-resolv: NetworkManager ($NM) + mobile data ($MOB)"
	[ -f $NM ] && grep -E '^(search|domain|options)[[:space:]]' $NM
	{ [ -f $NM ] && sed -n 's/^nameserver[[:space:]]\+//p' $NM; [ -f $MOB ] && cat $MOB; } | awk 'NF && !seen[$1]++ { print "nameserver " $1 }'
} > $OUT.tmp && mv $OUT.tmp $OUT
[ "$(readlink /etc/resolv.conf)" = $OUT ] || ln -sfn $OUT /etc/resolv.conf
