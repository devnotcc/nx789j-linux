#!/bin/sh
# Runs when systemd starts a shutdown (ExecStop of nx-phone-power.service). Debian's systemd is
# only PID 1 of a namespace, so its own reboot / power-off would just end the Linux side. Hand
# the request to the agent on the Android side (nx-linux.sh _agent), which waits for systemd to
# finish and then lets Android's init reboot or power off the phone cleanly.
# A plain stop of the Linux side (halt, nx-systemd.sh stop) asks for nothing.
case "$(systemctl list-jobs --no-legend 2>/dev/null)" in
*poweroff.target*start*) c=poweroff ;;
*reboot.target*start*) c=reboot ;;
*) exit 0 ;;
esac
# "systemctl reboot --reboot-argument=android" (Restart into Android, nx-to-android): when Linux is the default
# (bootmode linux), skip it for the next boot; the Android boot hook removes the flag again.
# A plain reboot stays in Linux: after a one-time Linux boot (Restart into Debian in Android,
# bootmode linux-once, which the boot hook has already reset to android) arm one more. Only a
# clean reboot from here does that; a crash or a forced restart still comes back to Android.
D=/android/data/nx-linux
if [ $c = reboot ]; then
	m=$(cat $D/bootmode 2>/dev/null)
	if [ "$(cat /run/systemd/reboot-param 2>/dev/null)" = android ]; then
		[ "$m" = linux ] && : > $D/android-once
	elif [ "$m" != linux ]; then
		echo linux-once > $D/bootmode
	fi
	sync
fi
echo $c > $D/ctl && touch /run/nx-power-requested
