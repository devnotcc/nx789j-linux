#!/bin/sh
# Input hotplug without a permanent udev daemon (no udevd runs on this phone, see nx-tune):
# when a new /dev/input/eventN appears (USB hub, keyboard, mouse, gamepad), run udevd for one
# short pass over just that device so the compositor and logind get the "add" event.
# Unplugged devices need nothing: libinput drops them when their node returns ENODEV.
export SYSTEMD_IGNORE_CHROOT=1
mkdir -p /run/udev /run/nx-input /var/log/nx
while :; do
	new=
	for e in /sys/class/input/event*; do
		[ -r $e/dev ] || continue
		# (known = same input device as last time: an eventN number is reused at once when a
		# device goes and another comes, and nothing removes the old udev record)
		dev=$(readlink -f $e/..)
		[ "$(cat /run/nx-input/${e##*/} 2>/dev/null)" = "$dev" ] && [ -e /run/udev/data/c13:$(cut -d: -f2 $e/dev) ] && continue
		echo "$dev" > /run/nx-input/${e##*/}; new="$new $dev $e"
	done
	# raw HID devices: USB security keys (FIDO2 / passkeys, U2F) are used through /dev/hidrawN.
	# Without devtmpfs nobody creates the node for a key plugged in after boot, and without a
	# udev pass it stays root-only: systemd's 60-fido-id.rules marks it a security token and
	# 70-uaccess.rules gives the logged-in user access (the browser then finds it).
	for h in /sys/class/hidraw/hidraw*; do
		[ -r $h/dev ] || continue
		n=${h##*/}; mm=$(cat $h/dev); maj=${mm%%:*}; min=${mm##*:}
		if [ "$(stat -c %t:%T /dev/$n 2>/dev/null)" != "$(printf '%x:%x' $maj $min)" ]; then
			rm -f /dev/$n; mknod -m 600 /dev/$n c $maj $min
		fi
		dev=$(readlink -f $h)
		[ "$(cat /run/nx-input/$n 2>/dev/null)" = "$dev" ] && [ -e /run/udev/data/c$mm ] && continue
		echo "$dev" > /run/nx-input/$n; new="$new $dev"
	done
	# USB sound cards (DACs, USB-C headsets), at start and when plugged in later: the udev pass
	# gives their nodes the audio group and the logged-in user access, and marks the card
	# SOUND_INITIALIZED, without which PipeWire ignores it. USB cards only: the phone's own
	# Qualcomm card belongs to Android's audio HAL (Debian's speaker output goes through it).
	# Known = same card on the same plug-in, told by its sysfs inode: a new one on every plug-in,
	# while the path and even the USB device number repeat (unplugging switches the USB host off
	# and numbering starts again).
	# A card that went away: no udev daemon tells PipeWire, and WirePlumber kept the dead card as
	# the default output, retrying it at 90% CPU (no sound, volume keys stuck, slow video). It is
	# restarted for the logged-in user, which drops the card (a moment of silence, only then).
	gone=
	for k in /run/nx-input/snd-card*; do
		[ -e "$k" ] || continue
		set -- $(cat $k)
		[ "$(stat -c %i "$1" 2>/dev/null)" = "$2" ] && continue
		rm -f $k; gone="$gone ${k##*/snd-}"
	done
	if [ -n "$gone" ]; then
		for r in /run/user/[0-9]*; do
			u=${r##*/}; [ "$u" -ge 1000 ] 2>/dev/null || continue
			runuser -u "$(id -nu $u)" -- env XDG_RUNTIME_DIR=$r DBUS_SESSION_BUS_ADDRESS=unix:path=$r/bus \
				systemctl --user restart wireplumber >/dev/null 2>&1
		done
		echo "sound card removed:$gone (WirePlumber restarted)"
	fi
	for c in /sys/class/sound/card*; do
		[ -e $c ] || continue
		dev=$(readlink -f $c)
		case $dev in */usb*/sound/card*) ;; *) continue ;; esac
		n=${c##*/}; key="$dev $(stat -c %i $dev)"
		[ "$(cat /run/nx-input/snd-$n 2>/dev/null)" = "$key" ] && continue
		echo "$key" > /run/nx-input/snd-$n
		# the card's nodes (controlC, pcmC...) first, the card last: its rule runs once they exist.
		# SELinux (Android's policy) keeps the kernel from adding nodes to /dev/snd after boot
		# ("kdevtmpfs denied write name=snd"), so they are made here, like the hidraw ones above.
		for x in $dev/*/dev; do
			d=${x%/dev}; nm=$(sed -n 's/^DEVNAME=//p' $d/uevent); mm=$(cat $x)
			case $nm in snd/*) ;; *) continue ;; esac
			if [ "$(stat -c %t:%T /dev/$nm 2>/dev/null)" != "$(printf '%x:%x' ${mm%%:*} ${mm##*:})" ]; then
				mkdir -p /dev/snd; rm -f /dev/$nm; mknod -m 600 /dev/$nm c ${mm%%:*} ${mm##*:}
			fi
			new="$new $d"
		done
		new="$new $dev"
	done
	# a keyboard/mouse whose driver failed to attach when it was plugged in ("usbhid: probe ...
	# failed with error -32", seen with a Razer mouse behind a hub): reconnect it logically, up
	# to three times per plug-in
	for i in /sys/bus/usb/devices/*:*; do
		[ "$(cat $i/bInterfaceClass 2>/dev/null)" = 03 ] && [ ! -e $i/driver ] || continue
		d=${i%:*}; k=/run/nx-input/retry-${d##*/}-$(cat $d/devnum 2>/dev/null)
		n=$(cat $k 2>/dev/null || echo 0); [ $n -lt 3 ] || continue
		echo $((n + 1)) > $k
		echo "input driver not attached to $(cat $d/product 2>/dev/null) (${d##*/}): reconnecting"
		echo 0 > $d/authorized; sleep 1; echo 1 > $d/authorized; sleep 3
		break
	done
	# an external display (USB-C DisplayPort/HDMI adapter) plugged or unplugged: the compositor
	# only learns of it from a udev "change" event on the graphics card
	dp=$(cat /sys/class/drm/card0-DP-*/status 2>/dev/null | tr '
' ' ')
	if [ "$dp" != "${dpold-$dp}" ]; then
		/usr/lib/systemd/systemd-udevd >>/var/log/nx/udevd.log 2>&1 </dev/null &
		U=$!; sleep 1
		udevadm trigger --action=change /sys/class/drm/card0 >/dev/null 2>&1
		udevadm settle -t 10 >/dev/null 2>&1
		kill $U 2>/dev/null; sleep 1; kill -9 $U 2>/dev/null
		echo "display connector: $dp"
		# switch the new output on / the phone screen back on (Plasma leaves a new output disabled;
		# under LXQt this applies the docked or undocked layout)
		sleep 2; /usr/local/bin/nx-display outputs >/dev/null 2>&1
	fi
	dpold=$dp
	# charger plugged / unplugged or the battery's charge state changed: UPower (and with it the
	# desktop's battery icon) only updates power supplies on udev "change" events. Without them
	# the charger entries kept the state from boot and the battery was only polled (minutes late).
	ps=$(cat /sys/class/power_supply/usb/online /sys/class/power_supply/wireless/online /sys/class/power_supply/battery/status 2>/dev/null | tr '
' ' ')
	if [ "$ps" != "${psold-}" ]; then
		/usr/lib/systemd/systemd-udevd >>/var/log/nx/udevd.log 2>&1 </dev/null &
		U=$!; sleep 1
		udevadm trigger --action=change --subsystem-match=power_supply >/dev/null 2>&1
		udevadm settle -t 10 >/dev/null 2>&1
		kill $U 2>/dev/null; sleep 1; kill -9 $U 2>/dev/null
		[ -n "${psold-}" ] && echo "power supply: $ps"
	fi
	psold=$ps
	if [ -n "$new" ]; then
		/usr/lib/systemd/systemd-udevd >>/var/log/nx/udevd.log 2>&1 </dev/null &
		U=$!; sleep 1
		udevadm trigger --action=add $new >/dev/null 2>&1
		udevadm settle -t 10 >/dev/null 2>&1
		kill $U 2>/dev/null; sleep 1; kill -9 $U 2>/dev/null
		echo "announced:$(for d in $new; do case $d in */event*|*/hidraw*|*/sound/card*) printf ' %s' ${d##*/};; esac; done)"
	fi
	sleep 2
done
